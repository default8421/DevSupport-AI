# @author: liuqinhe
# 本栈内层 nginx：静态资源 + /api 反代。
# __CONTEXT_PATH__ 在镜像构建时被 sed 替换成 deploy/.env 里的 CONTEXT_PATH。
#
# 外层反代只做原样透传，前缀剥离放在这里，后端 FastAPI 不用感知 root_path。
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 16m;

    # 给容器 healthcheck 用，不经过前缀
    location = /healthz {
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = __CONTEXT_PATH__ {
        return 301 __CONTEXT_PATH__/;
    }

    # 剥掉前缀转给后端：/devsupport/api/xxx -> http://api:8000/api/xxx
    location __CONTEXT_PATH__/api/ {
        proxy_pass http://api:8000/api/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # /api/chat 是 SSE 流式，必须关缓冲，否则 token 会攒到最后一次性吐出
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location __CONTEXT_PATH__/ {
        try_files $uri $uri/ __CONTEXT_PATH__/index.html;
    }
}
