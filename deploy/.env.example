# 本机用 docker compose 跑整套时的模板：cp .env.example .env
# 只有 docker-compose.yml（不叠加 server overlay）时使用，端口默认全绑回环。

APP_PUBLISH=127.0.0.1:8090
CONTEXT_PATH=/devsupport

MYSQL_PUBLISH=127.0.0.1:3308
REDIS_PUBLISH=127.0.0.1:6381

MYSQL_ROOT_PASSWORD=root123
MYSQL_USER=devsupport
MYSQL_PASSWORD=devsupport123
MYSQL_DB=devsupport

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

JWT_SECRET=local-dev-only-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# 本机也要填自己的 key，仓库里不要提交真值
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_SMALL=qwen-turbo
LLM_MODEL_LARGE=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
RERANK_MODEL=gte-rerank-v2
MILVUS_COLLECTION=knowledge_chunk

APP_ENV=dev
LOG_LEVEL=INFO
