# 服务器 deploy/.env 模板。复制成 deploy/.env 后填真值，该文件不进 git。
#   cp .env.server.example .env
# 口令现场生成，不要沿用任何示例值：
#   openssl rand -base64 24

# ===== 对外发布 =====
# 只绑 docker 网桥网关，让本机反代进来；绝不要写 0.0.0.0
APP_PUBLISH=172.18.0.1:8090
# 外层反代透传的路径前缀，必须与 nginx location 一致；改这个要重建 web 镜像
CONTEXT_PATH=/devsupport

# ===== 数据端口：只绑回环，避开同机已占用的 3306/3307/6380 =====
MYSQL_PUBLISH=127.0.0.1:3308
REDIS_PUBLISH=127.0.0.1:6381

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=__CHANGE_ME__
MYSQL_USER=devsupport
MYSQL_PASSWORD=__CHANGE_ME__
MYSQL_DB=devsupport

# ===== MinIO（Milvus 的对象存储后端，不对外发布）=====
MINIO_ACCESS_KEY=__CHANGE_ME__
MINIO_SECRET_KEY=__CHANGE_ME__

# ===== 认证 =====
JWT_SECRET=__CHANGE_ME__
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ===== 通义 DashScope =====
DASHSCOPE_API_KEY=__CHANGE_ME__
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_SMALL=qwen-turbo
LLM_MODEL_LARGE=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
RERANK_MODEL=gte-rerank-v2
MILVUS_COLLECTION=knowledge_chunk

# ===== 其它 =====
APP_ENV=prod
LOG_LEVEL=INFO
